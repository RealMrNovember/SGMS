# Copy to .env (local or VDS). Never commit .env.

# Bind-mount root for Postgres/Redis (absolute path recommended on VDS)
# Local (repo root'tan compose çalıştırırken):
SGMS_DATA_DIR=infra/docker/data
# VDS (aaPanel): infra/docker/.env.vds.example dosyasına bakın

POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_USER=sgms
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sgms
POSTGRES_PORT=5432

REDIS_HOST_BIND=127.0.0.1
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379

# Soketi (WebSocket — Pusher protokolü, Redis adapter)
SOKETI_HOST_BIND=127.0.0.1
SOKETI_PORT=6001
SOKETI_APP_ID=sgms
SOKETI_APP_KEY=change-me-soketi-key
SOKETI_APP_SECRET=change-me-soketi-secret
SOKETI_DEBUG=0
