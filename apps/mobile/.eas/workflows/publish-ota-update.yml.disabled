# GECE BOYU GEÇİCİ DEVRE DIŞI — 2026-07-21
#
# Bu workflow, main'e apps/mobile/** değişikliği push'landığında OTATOMATİK olarak
# production kanalına OTA güncellemesi yayınlıyordu. Kullanıcının bu geceki gorev
# talimatı açıkça "eas update (OTA) ÇALIŞTIRILMAZ — testleri bilgisayarda yapmanı
# istiyorum, çalışmayan güncellemeyi insanların telefonlarına gönderemeyiz" diyor.
#
# Bu gece Faz 42/40/39/41 kapsamında apps/mobile/** içine commit+push yapılacağı için
# bu workflow .disabled uzantısıyla yeniden adlandırıldı (EAS .eas/workflows/*.yml
# dosyalarını okuyor, .disabled uzantılı dosyayı görmezden geliyor).
#
# SABAH: Mobil değişiklikleri kendi gözünüzle inceleyip onayladıktan sonra, bu dosyayı
# "publish-ota-update.yml" olarak geri adlandırıp tekrar aktif edebilirsiniz.
# Orijinal içerik aşağıda değişmeden korundu.

name: SGMS Mobil — Otomatik OTA Güncelleme

on:
  push:
    branches: ['main']
    paths:
      - apps/mobile/**

concurrency:
  cancel_in_progress: true
  group: ${{ workflow.filename }}-${{ github.ref }}

jobs:
  typecheck:
    name: Mobil TypeScript kontrolü
    steps:
      - uses: eas/checkout
      - uses: eas/install_node_modules
      - name: tsc --noEmit
        working_directory: apps/mobile
        run: pnpm exec tsc --noEmit

  publish_ota_update:
    name: OTA güncelleme yayınla (production kanalı)
    needs: [typecheck]
    type: update
    params:
      channel: production
      platform: android
      message: ${{ github.commit_message }}
