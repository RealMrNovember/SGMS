DATABASE_URL="postgresql://sgms:change-me-strong-password@127.0.0.1:5432/sgms?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://sgms.cicibyte.com"
NEXTAUTH_URL="https://sgms.cicibyte.com"

LICENSE_API_BASE_URL=https://license.cicibyte.com/api/v1/license
LICENSE_APP_CODE=sgms
LICENSE_API_KEY=
LICENSE_API_TIMEOUT_MS=15000
API_TOKEN_TTL_DAYS=30

# Redis (opsiyonel — rate limit, token revoke cache)
# REDIS_URL=redis://:password@127.0.0.1:6380
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6380
# REDIS_PASSWORD=
MESSAGE_RATE_LIMIT_PER_MINUTE=30

# Turnike üçüncü parti webhook
# TURNSTILE_WEBHOOK_SECRET=change-me

# SEED_PLACEHOLDER_AVATARS=true  # demo users get /placeholders/*.svg avatars on db:seed

# Avatar storage — local (default) or Cloudflare R2
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=r2
# R2_USE_SIGNED_URLS=false
# R2_SIGNED_URL_TTL_SECONDS=3600
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=sgms-avatars
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Soketi realtime (optional — falls back to SSE when unset)
SOKETI_APP_ID=sgms
SOKETI_APP_KEY=
SOKETI_APP_SECRET=
SOKETI_HOST=127.0.0.1
SOKETI_PORT=6001
SOKETI_USE_TLS=false
NEXT_PUBLIC_SOKETI_KEY=
NEXT_PUBLIC_SOKETI_WS_HOST=
NEXT_PUBLIC_SOKETI_WS_PATH=/realtime/app
NEXT_PUBLIC_SOKETI_WS_PORT=443
NEXT_PUBLIC_SOKETI_WSS_PORT=443
NEXT_PUBLIC_SOKETI_FORCE_TLS=true
