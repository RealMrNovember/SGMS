model Invoice {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  gymMemberId    String        @map("gym_member_id")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency       String        @default("TRY")
  status         InvoiceStatus @default(UNPAID)
  notes          String?
  /// Resmi/e-fatura alanları (Faz 18)
  invoiceNumber  String?       @map("invoice_number")
  taxId          String?       @map("tax_id")
  issuedAt       DateTime?     @map("issued_at")
  issuedById     String?       @map("issued_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember      GymMember       @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  issuedBy       User?           @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  invoiceItems   InvoiceItem[]
  paymentIntents PaymentIntent[]
  transactions   Transaction[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, gymMemberId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([gymMemberId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String   @map("invoice_id")
  productId String?  @map("product_id")
  name      String
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
