model PaymentIntent {
  id              String              @id @default(cuid())
  organizationId  String              @map("organization_id")
  gymMemberId     String              @map("gym_member_id")
  invoiceId       String?             @map("invoice_id")
  requestedAmount Decimal             @map("requested_amount") @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentIntentStatus @default(PENDING)
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, gymMemberId, status])
  @@index([organizationId, status, createdAt])
  @@index([gymMemberId, createdAt])
  @@map("payment_intents")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String?          @map("organization_id")
  userId         String           @map("user_id")
  type           NotificationType
