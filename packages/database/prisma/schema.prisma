// Faz 18 — GDPR / sözleşme / silme talebi
// ---------------------------------------------------------------------------

enum AccountDeletionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ContractTemplateType {
  MEMBERSHIP
  RISK_WAIVER
}

model AccountDeletionRequest {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  requestedById  String                 @map("requested_by_id")
  reason         String?                @db.Text
  status         AccountDeletionStatus  @default(PENDING)
  reviewedById   String?                @map("reviewed_by_id")
  reviewedAt     DateTime?              @map("reviewed_at")
  reviewNotes    String?                @map("review_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("AccountDeletionRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("AccountDeletionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@map("account_deletion_requests")
}

model ContractTemplate {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  name           String
  type           ContractTemplateType @default(MEMBERSHIP)
  /// {uyeAdi}, {planAdi}, {tarih}, {fiyat} vb. — fillEmailTemplate deseni
  bodyText       String               @map("body_text") @db.Text
  isDefault      Boolean              @default(false) @map("is_default")
  isActive       Boolean              @default(true) @map("is_active")
  updatedById    String?              @map("updated_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("ContractTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, type, isActive])
  @@map("contract_templates")
}

// ---------------------------------------------------------------------------
// Faz 22 — HR
// ---------------------------------------------------------------------------

enum LeaveType {
  ANNUAL
  EXCUSED
  MEDICAL
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  userId         String             @map("user_id")
  type           LeaveType          @default(ANNUAL)
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  reason         String?            @db.Text
  status         LeaveRequestStatus @default(PENDING)
  reviewedById   String?            @map("reviewed_by_id")
  reviewedAt     DateTime?          @map("reviewed_at")
  reviewNotes    String?            @map("review_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("LeaveRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, startDate])
  @@index([userId, startDate])
  @@map("leave_requests")
}

model Shift {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  /// 0=Pazar … 6=Cumartesi (JS getDay)
  dayOfWeek      Int      @map("day_of_week")
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String   @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("ShiftCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignments  ShiftAssignment[]

  @@index([organizationId, dayOfWeek, isActive])
  @@map("shifts")
}

model ShiftAssignment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  shiftId        String   @map("shift_id")
  userId         String   @map("user_id")
  /// Somut hafta günü (opsiyonel — boşsa şablon dayOfWeek kullanılır)
  weekStartDate  DateTime? @map("week_start_date") @db.Date
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shift        Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId, weekStartDate])
  @@index([organizationId, userId])
  @@index([organizationId, weekStartDate])
  @@map("shift_assignments")
}

model PerformanceReview {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  subjectUserId  String   @map("subject_user_id")
  reviewerId     String   @map("reviewer_id")
  periodLabel    String   @map("period_label")
  score          Int
  notes          String   @db.Text
  reviewedAt     DateTime @default(now()) @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      User         @relation("PerformanceReviewSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([organizationId, subjectUserId, reviewedAt])
  @@map("performance_reviews")
}

model DisciplinaryRecord {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  subjectUserId  String   @map("subject_user_id")
  createdById    String   @map("created_by_id")
  title          String
  description    String   @db.Text
  severity       String   @default("WARNING")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      User         @relation("DisciplinaryRecordSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DisciplinaryRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, subjectUserId, occurredAt])
  @@map("disciplinary_records")
}

// ---------------------------------------------------------------------------
// Faz 23 — Ekipman
// ---------------------------------------------------------------------------

enum EquipmentCategory {
  CARDIO
  STRENGTH
  GROUP_CLASS
  OTHER
}

enum EquipmentStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum MaintenanceFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

model GymEquipment {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  name              String
  category          EquipmentCategory @default(OTHER)
  status            EquipmentStatus   @default(OPERATIONAL)
  serialNumber      String?           @map("serial_number")
  purchaseDate      DateTime?         @map("purchase_date") @db.Date
  purchasePrice     Decimal?          @map("purchase_price") @db.Decimal(12, 2)
  warrantyExpiresAt DateTime?         @map("warranty_expires_at") @db.Date
  location          String?
  photoUrl          String?           @map("photo_url")
  qrTokenHash       String            @unique @map("qr_token_hash")
  publicCode        String            @unique @map("public_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceLogs  EquipmentServiceLog[]
  schedules    MaintenanceSchedule[]

  @@index([organizationId, status])
  @@index([organizationId, category])
  @@map("gym_equipment")
}

model EquipmentServiceLog {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  equipmentId      String    @map("equipment_id")
  reportedAt       DateTime  @default(now()) @map("reported_at")
  reportedById     String    @map("reported_by_id")
  issueDescription String    @map("issue_description") @db.Text
  serviceProvider  String?   @map("service_provider")
  serviceDate      DateTime? @map("service_date") @db.Date
  cost             Decimal?  @db.Decimal(12, 2)
  warrantyClaim    Boolean   @default(false) @map("warranty_claim")
  photoUrl         String?   @map("photo_url")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    GymEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reportedBy   User         @relation("EquipmentServiceReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)

  @@index([organizationId, equipmentId, reportedAt])
  @@map("equipment_service_logs")
}

model MaintenanceSchedule {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  /// Opsiyonel — tesis geneli (klima/sauna) için null olabilir
  equipmentId    String?              @map("equipment_id")
  title          String
  frequency      MaintenanceFrequency @default(MONTHLY)
  nextDueDate    DateTime             @map("next_due_date") @db.Date
  lastDoneAt     DateTime?            @map("last_done_at") @db.Date
  notes          String?              @db.Text
  isActive       Boolean              @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    GymEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, nextDueDate, isActive])
  @@index([equipmentId])
  @@map("maintenance_schedules")
}

// ---------------------------------------------------------------------------
// Faz 25 — Kasa vardiyası
// ---------------------------------------------------------------------------

model CashRegisterShift {
  id                      String    @id @default(cuid())
  organizationId          String    @map("organization_id")
  openedById              String    @map("opened_by_id")
  openedAt                DateTime  @default(now()) @map("opened_at")
  openingBalance          Decimal   @map("opening_balance") @db.Decimal(12, 2)
  closedById              String?   @map("closed_by_id")
  closedAt                DateTime? @map("closed_at")
  closingBalanceExpected  Decimal?  @map("closing_balance_expected") @db.Decimal(12, 2)
  closingBalanceCounted   Decimal?  @map("closing_balance_counted") @db.Decimal(12, 2)
  discrepancy             Decimal?  @db.Decimal(12, 2)
  notes                   String?   @db.Text
  /// X/Z rapor özeti (ödeme yöntemi kırılımı vb.)
  reportSnapshot          Json?     @map("report_snapshot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedBy     User          @relation("CashShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy     User?         @relation("CashShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([organizationId, openedAt])
  @@index([organizationId, closedAt])
  @@map("cash_register_shifts")
}
