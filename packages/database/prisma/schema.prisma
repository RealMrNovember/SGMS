// ---------------------------------------------------------------------------
// Lead / LeadFollowUp — potansiyel müşteri (satış öncesi) takibi (Faz 17.0).
// Bir aday salonu gezip kayıt olmadan ayrıldığında burada tutulur; dönüşünce
// tek tıkla gerçek bir GymMember'a çevrilir (veri tekrar girilmez).
// ---------------------------------------------------------------------------

enum LeadSource {
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  WEBSITE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP_SCHEDULED
  CONVERTED
  LOST
}

enum LeadFollowUpMethod {
  CALL
  MESSAGE
  EMAIL
}

model Lead {
  id                String     @id @default(cuid())
  organizationId    String     @map("organization_id")
  name              String
  phone             String?
  email             String?
  source            LeadSource @default(WALK_IN)
  interestedPlan    String?    @map("interested_plan")
  status            LeadStatus @default(NEW)
  notes             String?    @db.Text
  assignedToId      String?    @map("assigned_to_id")
  createdById       String     @map("created_by_id")
  convertedMemberId String?    @unique @map("converted_member_id")
  convertedAt       DateTime?  @map("converted_at")
  lostAt            DateTime?  @map("lost_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo      User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User           @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  convertedMember GymMember?     @relation("LeadConvertedToMember", fields: [convertedMemberId], references: [id], onDelete: SetNull)
  followUps       LeadFollowUp[]

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([phone])
  @@index([email])
  @@map("leads")
}

model LeadFollowUp {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  leadId         String             @map("lead_id")
  scheduledAt    DateTime           @map("scheduled_at")
  method         LeadFollowUpMethod @default(CALL)
  notes          String?            @db.Text
  completedAt    DateTime?          @map("completed_at")
  createdById    String             @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, scheduledAt])
  @@index([leadId, scheduledAt])
  @@map("lead_follow_ups")
}

// ---------------------------------------------------------------------------
// Faz 17 — Üyelik senaryoları, ders yönetimi, kupon, misafir
// ---------------------------------------------------------------------------

enum MembershipFreezeReason {
  MILITARY
  MEDICAL
  TRAVEL
  OTHER
}

enum MembershipFreezeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MembershipGroupType {
  INDIVIDUAL
  COUPLE
  FAMILY
  CORPORATE
}

enum ClassBookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum DiscountType {
  FIXED
  PERCENT
}

model MembershipFreeze {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  gymMemberId     String                 @map("gym_member_id")
  startDate       DateTime               @map("start_date") @db.Date
  endDate         DateTime               @map("end_date") @db.Date
  reason          MembershipFreezeReason @default(OTHER)
  notes           String?                @db.Text
  status          MembershipFreezeStatus @default(PENDING)
  requestedById   String?                @map("requested_by_id")
  approvedById    String?                @map("approved_by_id")
  decidedAt       DateTime?              @map("decided_at")
  daysExtended    Int                    @default(0) @map("days_extended")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation("MembershipFreezeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("MembershipFreezeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([gymMemberId, status])
  @@map("membership_freezes")
}

model MembershipTransfer {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fromMemberId   String   @map("from_member_id")
  toMemberId     String   @map("to_member_id")
  remainingDays  Int      @map("remaining_days")
  planId         String?  @map("plan_id")
  notes          String?  @db.Text
  approvedById   String   @map("approved_by_id")
  transferredAt  DateTime @default(now()) @map("transferred_at")
  creditAmount   Decimal? @map("credit_amount") @db.Decimal(10, 2)
  creditCurrency String?  @map("credit_currency")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromMember   GymMember          @relation("MembershipTransferFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember     GymMember          @relation("MembershipTransferTo", fields: [toMemberId], references: [id], onDelete: Restrict)
  plan         GymMembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  approvedBy   User               @relation("MembershipTransferApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([organizationId, transferredAt])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@map("membership_transfers")
}

model MembershipGroup {
  id               String              @id @default(cuid())
  organizationId   String              @map("organization_id")
  name             String
  type             MembershipGroupType @default(FAMILY)
  discountPercent  Decimal             @default(0) @map("discount_percent") @db.Decimal(5, 2)
  companyName      String?             @map("company_name")
  billingNotes     String?             @map("billing_notes") @db.Text
  createdById      String              @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("MembershipGroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members      GymMember[]

  @@index([organizationId, type])
  @@map("membership_groups")
}

model GymClass {
  id              String  @id @default(cuid())
  organizationId  String  @map("organization_id")
  name            String
  description     String? @db.Text
  trainerId       String? @map("trainer_id")
  roomName        String? @map("room_name")
  capacity        Int     @default(15)
  durationMinutes Int     @default(60) @map("duration_minutes")
  /// Haftanın günleri 0=Pazar … 6=Cumartesi
  weeklyDays      Int[]   @map("weekly_days")
  /// "HH:mm" yerel saat
  startTime       String  @map("start_time")
  isActive        Boolean @default(true) @map("is_active")
  createdById     String  @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trainer      User?         @relation("GymClassTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("GymClassCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sessions     ClassSession[]

  @@index([organizationId, isActive])
  @@index([trainerId])
  @@map("gym_classes")
}

model ClassSession {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  gymClassId     String    @map("gym_class_id")
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  capacity       Int
  trainerId      String?   @map("trainer_id")
  roomName       String?   @map("room_name")
  isCancelled    Boolean   @default(false) @map("is_cancelled")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymClass     GymClass      @relation(fields: [gymClassId], references: [id], onDelete: Cascade)
  bookings     ClassBooking[]
  checkIns     CheckIn[]

  @@unique([gymClassId, startsAt])
  @@index([organizationId, startsAt])
  @@index([gymClassId, startsAt])
  @@map("class_sessions")
}

model ClassBooking {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  classSessionId String             @map("class_session_id")
  gymMemberId    String             @map("gym_member_id")
  status         ClassBookingStatus @default(BOOKED)
  waitlistPos    Int?               @map("waitlist_pos")
  promotedAt     DateTime?          @map("promoted_at")
  createdById    String?            @map("created_by_id")
  cancelledAt    DateTime?          @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ClassBookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([classSessionId, gymMemberId])
  @@index([organizationId, status])
  @@index([gymMemberId, createdAt])
  @@map("class_bookings")
}

model DiscountCode {
  id             String       @id @default(cuid())
  organizationId String?      @map("organization_id")
  code           String
  type           DiscountType @default(PERCENT)
  value          Decimal      @db.Decimal(10, 2)
  maxUses        Int?         @map("max_uses")
  usedCount      Int          @default(0) @map("used_count")
  validFrom      DateTime?    @map("valid_from")
  validUntil     DateTime?    @map("valid_until")
  isActive       Boolean      @default(true) @map("is_active")
  createdById    String       @map("created_by_id")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("DiscountCodeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  redemptions  DiscountRedemption[]

  @@unique([organizationId, code])
  @@index([code])
  @@index([organizationId, isActive])
  @@map("discount_codes")
}

model DiscountRedemption {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  discountCodeId String   @map("discount_code_id")
  gymMemberId    String?  @map("gym_member_id")
  amountSaved    Decimal  @map("amount_saved") @db.Decimal(10, 2)
  context        String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  gymMember    GymMember?   @relation(fields: [gymMemberId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([discountCodeId])
  @@map("discount_redemptions")
}

model GuestPass {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  guestName      String    @map("guest_name")
  guestPhone     String?   @map("guest_phone")
  hostMemberId   String?   @map("host_member_id")
  issuedById     String    @map("issued_by_id")
  validFrom      DateTime  @map("valid_from")
  validUntil     DateTime  @map("valid_until")
  qrTokenHash    String    @unique @map("qr_token_hash")
  revokedAt      DateTime? @map("revoked_at")
  usedAt         DateTime? @map("used_at")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostMember   GymMember?   @relation("GuestPassHost", fields: [hostMemberId], references: [id], onDelete: SetNull)
  issuedBy     User         @relation("GuestPassIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  checkIns     CheckIn[]

  @@index([organizationId, validUntil])
  @@index([hostMemberId])
  @@map("guest_passes")
}

