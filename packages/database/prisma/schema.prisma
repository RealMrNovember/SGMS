// ---------------------------------------------------------------------------
// Aşağıdaki 6 enum + 9 model (bkz. TenantPaymentGateway/Product/MemberCard/
// Invoice/InvoiceItem/PaymentIntent/Notification/GymAccessLog/GymMemberActivity),
// başka bir oturumda doğrudan production'a `db push` ile eklenmiş, hiç commit
// edilmemiş bir tenant-seviyeli POS/fatura/ödeme-ağgeçidi çalışmasıydı (2026-07-19
// tarihli deploy sırasında keşfedildi). Uygulama kodu henüz bu modelleri
// kullanmıyor — yalnızca şema production'daki gerçek durumu yansıtsın ve
// gelecekteki migration'lar bu tabloları yanlışlıkla silmesin diye buraya
// eklendi. Gerçek kullanım (server actions/UI) ayrı bir görev.
// ---------------------------------------------------------------------------

enum GymAccessStatus {
  SUCCESS
  DENIED
}

enum GymMemberActivityType {
  CHECK_IN
  CHECK_OUT
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
  PARTIALLY_PAID
}

enum NotificationType {
  MESSAGE
  PROGRAM
  PAYMENT
  SYSTEM
}

