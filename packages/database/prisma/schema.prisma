  gymMemberId    String  @map("gym_member_id")
  cardAlias      String  @map("card_alias")
  paymentToken   String  @map("payment_token")
  brand          String?
  lastFour       String? @map("last_four")
  expiryMonth    Int?    @map("expiry_month")
  expiryYear     Int?    @map("expiry_year")
  isDefault      Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, gymMemberId])
  @@index([gymMemberId, isDefault])
