// SGMS — Core ekosistem veritabanı şeması
// PostgreSQL 16 — infra/docker/docker-compose.yml
//
// Multi-tenant kuralı: tenant-scoped modeller organizationId taşır.
// gymMemberId / trainerId / userId erişimleri API katmanında aynı org ile doğrulanır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum DeviceType {
  TURNSTILE
  KIOSK
  SCANNER
  TABLET
  OTHER
}

enum DeviceStatus {
  PENDING
  ONLINE
  OFFLINE
  DISABLED
}

enum CentralLicenseStatus {
  UNKNOWN
  TRIAL
  ACTIVE
  EXPIRED
  REVOKED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  STAFF
  TRAINER
  VIEWER
}

enum MessageReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum AuditAction {
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CHANGED
  SUBSCRIPTION_CANCELED
  DEVICE_REGISTERED
  DEVICE_UPDATED
  DEVICE_DISABLED
  LICENSE_TRIAL_STARTED
  LICENSE_ACTIVATED
  LICENSE_VALIDATED
  LICENSE_HEARTBEAT
  LICENSE_EXPIRED
  CLOUD_TENANT_SYNCED
  CLOUD_SYNC_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  CLOUD_PAYMENT_SUCCEEDED
  CLOUD_PAYMENT_FAILED
  USER_CREATED
  USER_UPDATED
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  ACCESS_DENIED
  API_ERROR
  MEMBER_INVITED
  MEMBER_UPDATED
  MEMBER_REMOVED
  MEMBER_REGISTERED
  MEMBER_CHECK_IN
  MEASUREMENT_ADDED
  EXPENSE_ADDED
  EXPENSE_VOIDED
  PAYMENT_RECORDED
  SETTINGS_CHANGED
  AUDIT_LOG_DELETED
  MESSAGE_REPORTED
  PARTNER_CREATED
  PARTNER_UPDATED
  PARTNER_ASSIGNED
  PARTNER_UNASSIGNED
  PARTNER_DISCOUNT_UPDATED
  PARTNER_CAPACITY_ADJUSTED
  PARTNER_TRIAL_EXTENDED
  PUSH_SUBSCRIBED
  PUSH_UNSUBSCRIBED
  TRAINER_PROFILE_UPDATED
  PT_SESSION_SCHEDULED
  PT_SESSION_COMPLETED
  PT_SESSION_CANCELED
  ORGANIZATION_HIERARCHY_LINKED
  ORGANIZATION_HIERARCHY_UNLINKED
  HIERARCHY_MEMBER_GRANTED
  HIERARCHY_MEMBER_REVOKED
  PAYMENT_PLAN_CREATED
  PAYMENT_PLAN_CANCELLED
}

enum HierarchyRole {
  COMPANY_ADMIN
  REGIONAL_MANAGER
}

enum PtCommissionModel {
  FIXED_PER_SESSION
  PERCENTAGE_OF_REVENUE
  TIERED
}

enum PtSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELED_BY_MEMBER
  CANCELED_BY_TRAINER
  NO_SHOW
}

enum GymMemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum ProgramType {
  WORKOUT
  NUTRITION
}

enum ApiTokenScope {
  STAFF
  ATHLETE
}

enum CheckInMethod {
  QR
  RFID
  MANUAL
  DEVICE
}

enum AccessDirection {
  ENTRY
  EXIT
}

enum AccessSubjectType {
  GYM_MEMBER
  STAFF
}

enum SyncBatchStatus {
  PENDING
  COMPLETED
  PARTIAL
  FAILED
}

enum ExpenseStatus {
  OPEN
  PAID
  VOID
}

enum TransactionType {
  CHARGE
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// User — platform kullanıcıları (web panel girişi)
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  name            String
  isSuperAdmin    Boolean    @default(false) @map("is_super_admin")
  isDemo          Boolean    @default(false) @map("is_demo")
  isPartner       Boolean    @default(false) @map("is_partner")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  locale          String     @default("tr")
  avatarUrl       String?    @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        OrganizationMember[]
  auditLogs          AuditLog[]           @relation("AuditLogActor")
  gymMemberProfile   GymMember?           @relation("GymMemberAccount")
  assignedAthletes   GymMember[]          @relation("GymMemberTrainer")
  trainingPrograms   TrainingProgram[]    @relation("TrainingProgramTrainer")
  sentMessages       DirectMessage[]      @relation("DirectMessageSender")
  receivedMessages   DirectMessage[]      @relation("DirectMessageReceiver")
  messageReports     MessageReport[]      @relation("MessageReportReporter")
  reviewedReports    MessageReport[]      @relation("MessageReportReviewer")
  apiTokens          ApiToken[]
  expensesCreated    Expense[]            @relation("ExpenseCreatedBy")
  transactionsCreated Transaction[]       @relation("TransactionCreatedBy")
  paymentPlansCreated PaymentPlan[]       @relation("PaymentPlanCreatedBy")
  staffCheckIns       CheckIn[]            @relation("StaffCheckIn")
  passwordResetTokens PasswordResetToken[]
  partnerProfile      Partner?
  pushSubscriptions   PushSubscription[]
  trainerProfiles     TrainerProfile[]
  ptSessionsAsTrainer PtSession[]          @relation("PtSessionTrainer")
  ptSessionsCreated   PtSession[]          @relation("PtSessionCreatedBy")
  hierarchyMemberships HierarchyMember[]

  @@index([status])
  @@index([isSuperAdmin])
  @@index([isPartner])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Partner — referans/temsilci hesabı. Kendi getirdiği (atanmış) organizasyonların
// üyelik süresi, özel indirimi ve ek kapasitesini sınırlı ve denetimli şekilde
// yönetebilir. Master Admin tarafından oluşturulur ve organizasyonlarla eşleştirilir.
// ---------------------------------------------------------------------------

model Partner {
  id             String  @id @default(cuid())
  userId         String  @unique @map("user_id")
  name           String
  code           String  @unique
  commissionRate Decimal @default(0) @db.Decimal(5, 2) @map("commission_rate")
  isActive       Boolean @default(true) @map("is_active")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations Organization[]

  @@index([isActive])
  @@map("partners")
}

// ---------------------------------------------------------------------------
// PushSubscription — tarayıcı Web Push aboneliği (VAPID). Kullanıcı bazlı, çoklu
// cihaz/tarayıcı desteklenir (aynı kullanıcı hem masaüstü hem telefon tarayıcısından
// abone olabilir).
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// TrainerProfile / PtSession — PT performans, komisyon ve prim yönetimi (Faz 21)
// ---------------------------------------------------------------------------

model TrainerProfile {
  id                 String            @id @default(cuid())
  organizationId     String            @map("organization_id")
  userId             String            @map("user_id")
  commissionModel    PtCommissionModel @default(FIXED_PER_SESSION) @map("commission_model")
  /** FIXED_PER_SESSION için TRY tutar, PERCENTAGE_OF_REVENUE/TIERED için yüzde (0-100). */
  baseCommissionRate Decimal           @default(0) @db.Decimal(7, 2) @map("base_commission_rate")
  hourlyRate         Decimal?          @db.Decimal(10, 2) @map("hourly_rate")
  isActive           Boolean           @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, isActive])
  @@map("trainer_profiles")
}

model PtSession {
  id              String          @id @default(cuid())
  organizationId  String          @map("organization_id")
  trainerUserId   String          @map("trainer_user_id")
  gymMemberId     String          @map("gym_member_id")
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int             @default(60) @map("duration_minutes")
  status          PtSessionStatus @default(SCHEDULED)
  revenueAmount   Decimal?        @db.Decimal(10, 2) @map("revenue_amount")
  commissionAmount Decimal?       @db.Decimal(10, 2) @map("commission_amount")
  notes           String?
  completedAt     DateTime?       @map("completed_at")
  createdById     String          @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trainer      User         @relation("PtSessionTrainer", fields: [trainerUserId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PtSessionCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, trainerUserId, scheduledAt])
  @@index([organizationId, gymMemberId])
  @@index([organizationId, status])
  @@map("pt_sessions")
}

// ---------------------------------------------------------------------------
// HierarchyMember — kurumsal hiyerarşi (Faz 30). Bir kullanıcıya, bir organizasyon
// düğümünün (şirket/bölge) tüm alt ağacı üzerinde salt-okunur konsolide görünürlük
// verir. Mevcut OrganizationRole (OWNER/ADMIN/STAFF/TRAINER/VIEWER) yetki sistemine
// dokunmaz — tamamen ek ve ayrı bir katmandır; kullanıcı kendi şubesinde ayrıca bir
// OrganizationMember rolüne de sahip olabilir.
// ---------------------------------------------------------------------------

model HierarchyMember {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  userId         String        @map("user_id")
  role           HierarchyRole
  isActive       Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@map("hierarchy_members")
}

// ---------------------------------------------------------------------------
// PasswordResetToken — "şifremi unuttum" imzalı, süreli token (e-posta cloud.cicibyte.com üzerinden gider)
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Organization — spor salonu / tenant
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String             @default("TR")
  timezone  String             @default("Europe/Istanbul")
  status    OrganizationStatus @default(PENDING)
  settings  Json               @default("{}")

  // Org düzeyinde merkezi platform kimliği (cloud.cicibyte.com — CiciByte Cloud tenant sync)
  installationId       String               @unique @map("installation_id")
  centralLicenseKey    String?              @unique @map("central_license_key")
  centralLicenseStatus CentralLicenseStatus @default(UNKNOWN) @map("central_license_status")
  centralLicenseType   String?              @map("central_license_type")
  licenseExpiresAt     DateTime?            @map("license_expires_at")
  trialStartedAt       DateTime?            @map("trial_started_at")
  lastLicenseCheckAt   DateTime?            @map("last_license_check_at")

  // Partner (temsilci) ataması — bu organizasyonu getiren temsilci, atandıysa
  // üyelik süresi / özel indirim / ek kapasite konularında sınırlı yönetim yetkisine sahiptir.
  partnerId String?  @map("partner_id")

  // Plan'ın taban limitlerinin üzerine eklenen, organizasyona özel ek kapasite
  // (temsilci veya Master Admin tarafından tanımlanır — bkz. lib/tenant-access.ts).
  extraMemberCapacity Int @default(0) @map("extra_member_capacity")
  extraStaffCapacity  Int @default(0) @map("extra_staff_capacity")
  extraDeviceCapacity Int @default(0) @map("extra_device_capacity")

  // Kurumsal hiyerarşi (Faz 30) — bu şube/bölgenin bağlı olduğu üst düğüm (şirket/bölge).
  // Zincirleme ile keyfi derinlikte ağaç kurulabilir (Şirket → Bölge → Şube), ayrı bir
  // "tip" alanı gerektirmeden.
  parentOrganizationId String? @map("parent_organization_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner            Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  parentOrganization Organization?        @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations Organization[]       @relation("OrganizationHierarchy")
  hierarchyMembers   HierarchyMember[]
  members            OrganizationMember[]
  subscriptions      Subscription[]
  devices            Device[]
  auditLogs          AuditLog[]
  gymMembershipPlans GymMembershipPlan[]
  gymMembers         GymMember[]
  healthMeasurements HealthMeasurement[]
  trainingPrograms   TrainingProgram[]
  directMessages     DirectMessage[]
  messageReports     MessageReport[]
  apiTokens          ApiToken[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  transactions       Transaction[]
  paymentPlans       PaymentPlan[]
  checkIns           CheckIn[]
  syncBatches        SyncBatch[]
  trainerProfiles    TrainerProfile[]
  ptSessions         PtSession[]

  @@index([status])
  @@index([centralLicenseStatus])
  @@index([partnerId])
  @@index([parentOrganizationId])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// OrganizationMember — kullanıcı ↔ salon köprüsü
// ---------------------------------------------------------------------------

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(STAFF)
  isActive       Boolean          @default(true) @map("is_active")
  rfidTag        String?          @map("rfid_tag")
  invitedAt      DateTime?        @map("invited_at")
  joinedAt       DateTime?        @map("joined_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, rfidTag])
  @@index([userId, isActive])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Plan — SaaS paket tanımları (çoklu para birimi destekli)
// ---------------------------------------------------------------------------

model Plan {
  id          String  @id @default(cuid())
  code        String
  name        String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  priceMonthly Decimal @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal @default(0) @map("price_yearly") @db.Decimal(10, 2)
  currency     String  @default("TRY")

  maxMembers Int @default(100) @map("max_members")
  maxDevices Int @default(2) @map("max_devices")
  maxStaff   Int @default(5) @map("max_staff")

  features Json @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@unique([code, currency])
  @@index([isActive, sortOrder])
  @@index([currency])
  @@map("plans")
}

// ---------------------------------------------------------------------------
// Subscription — organizasyon ↔ plan ilişkisi
// ---------------------------------------------------------------------------

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(TRIALING)
  billingCycle   BillingCycle       @default(MONTHLY) @map("billing_cycle")

  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  canceledAt         DateTime? @map("canceled_at")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")

  // Atanmış temsilci tarafından tanımlanan, bu organizasyona özel indirim (bkz. Partner).
  partnerDiscountPercent Int?    @default(0) @map("partner_discount_percent")
  partnerDiscountNote    String? @map("partner_discount_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([planId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Device — turnike, kiosk (limitler yerel Plan tablosundan denetlenir)
// ---------------------------------------------------------------------------

model Device {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  type           DeviceType   @default(TURNSTILE)
  status         DeviceStatus @default(PENDING)

  hardwareId String  @map("hardware_id")
  apiKeyHash String? @unique @map("api_key_hash")
  location   String?
  metadata   Json    @default("{}")

  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkIns     CheckIn[]
  syncBatches  SyncBatch[]

  @@unique([organizationId, hardwareId])
  @@index([organizationId, status])
  @@index([hardwareId])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// GymMembershipPlan — salonun müşterilerine sattığı yerel üyelik paketleri
// (SGMS SaaS Plan tablosundan bağımsız)
// ---------------------------------------------------------------------------

model GymMembershipPlan {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  description    String?
  durationDays   Int     @map("duration_days")
  price          Decimal @default(0) @db.Decimal(10, 2)
  currency       String  @default("TRY")
  isActive       Boolean @default(true) @map("is_active")
  sortOrder      Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMembers   GymMember[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
  @@map("gym_membership_plans")
}

// ---------------------------------------------------------------------------
// GymMember — salonun sporcu / üye kaydı (tenant müşterisi)
// ---------------------------------------------------------------------------

model GymMember {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  planId         String?         @map("plan_id")
  userId         String?         @unique @map("user_id")
  trainerId      String?         @map("trainer_id")
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  nationalId     String?         @map("national_id")
  isForeignMember Boolean        @default(false) @map("is_foreign_member")
  nationality    String?
  passportNumber String?         @map("passport_number")
  phone          String?
  email          String?
  birthDate      DateTime?       @map("birth_date") @db.Date
  gender         Gender          @default(UNSPECIFIED)
  status         GymMemberStatus @default(ACTIVE)
  membershipStartsAt DateTime?   @map("membership_starts_at")
  membershipEndsAt   DateTime?   @map("membership_ends_at")
  notes          String?         @db.Text
  locale         String          @default("tr")
  avatarUrl      String?         @map("avatar_url")
  rfidTag        String?         @map("rfid_tag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               GymMembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  user               User?               @relation("GymMemberAccount", fields: [userId], references: [id], onDelete: SetNull)
  trainer            User?               @relation("GymMemberTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  healthMeasurements HealthMeasurement[]
  trainingPrograms   TrainingProgram[]
  apiTokens          ApiToken[]
  expenses           Expense[]
  transactions       Transaction[]
  paymentPlans       PaymentPlan[]
  checkIns           CheckIn[]
  ptSessions         PtSession[]

  @@unique([organizationId, nationalId])
  @@unique([organizationId, passportNumber])
  @@unique([organizationId, rfidTag])
  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, trainerId])
  @@index([trainerId])
  @@index([userId])
  @@index([phone])
  @@index([email])
  @@map("gym_members")
}

// ---------------------------------------------------------------------------
// HealthMeasurement — sağlık ve performans ölçümleri
// ---------------------------------------------------------------------------

model HealthMeasurement {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  gymMemberId        String   @map("gym_member_id")
  weight             Decimal? @db.Decimal(5, 2)
  bodyFatPercentage  Decimal? @map("body_fat_percentage") @db.Decimal(5, 2)
  muscleMass         Decimal? @map("muscle_mass") @db.Decimal(5, 2)
  height             Decimal? @db.Decimal(5, 2)
  notes              String?  @db.Text
  measuredAt         DateTime @map("measured_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, gymMemberId, measuredAt])
  @@index([gymMemberId, measuredAt])
  @@map("health_measurements")
}

// ---------------------------------------------------------------------------
// TrainingProgram — antrenörün sporculara atadığı programlar
// ---------------------------------------------------------------------------

model TrainingProgram {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  gymMemberId    String      @map("gym_member_id")
  trainerId      String      @map("trainer_id")
  title          String
  type           ProgramType
  content        Json        @default("{}")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime?   @map("end_date") @db.Date
  isActive       Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  trainer      User         @relation("TrainingProgramTrainer", fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([organizationId, gymMemberId, isActive])
  @@index([organizationId, trainerId, isActive])
  @@index([gymMemberId, type, isActive])
  @@index([trainerId, startDate])
  @@map("training_programs")
}

// ---------------------------------------------------------------------------
// DirectMessage — tenant içi mesajlaşma (PT ↔ sporcu ↔ yönetim)
// ---------------------------------------------------------------------------

model DirectMessage {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  senderId       String   @map("sender_id")
  receiverId     String   @map("receiver_id")
  content        String   @db.Text
  isRead         Boolean  @default(false) @map("is_read")
  deliveredAt    DateTime? @map("delivered_at")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       User         @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  reports      MessageReport[]

  @@index([organizationId, receiverId, isRead, createdAt])
  @@index([organizationId, senderId, createdAt])
  @@index([organizationId, senderId, receiverId, createdAt])
  @@map("direct_messages")
}

model MessageReport {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  messageId      String              @map("message_id")
  reporterId     String              @map("reporter_id")
  reason         String              @db.Text
  status         MessageReportStatus @default(OPEN)
  reviewedById   String?             @map("reviewed_by_id")
  reviewedAt     DateTime?           @map("reviewed_at")
  reviewNotes    String?             @map("review_notes") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter     User          @relation("MessageReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("MessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([messageId])
  @@map("message_reports")
}

// ---------------------------------------------------------------------------
// ExpenseCategory — org bazlı hızlı POS kalemleri (Su, protein vb.)
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  defaultAmount  Decimal? @map("default_amount") @db.Decimal(10, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
  @@map("expense_categories")
}

// ---------------------------------------------------------------------------
// Expense — üye cari borç kalemi
// ---------------------------------------------------------------------------

model Expense {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  gymMemberId    String        @map("gym_member_id")
  categoryId     String?       @map("category_id")
  paymentPlanId  String?       @map("payment_plan_id")
  amount         Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  currency       String        @default("TRY")
  description    String?
  status         ExpenseStatus @default(OPEN)
  dueDate        DateTime?     @map("due_date")
  createdById    String        @map("created_by_id")
  paidAt         DateTime?     @map("paid_at")
  voidedAt       DateTime?     @map("voided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember        @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentPlan  PaymentPlan?     @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([organizationId, gymMemberId, status, createdAt])
  @@index([gymMemberId, status])
  @@index([organizationId, status, dueDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Transaction — tahsilat / iade / düzeltme
// ---------------------------------------------------------------------------

model Transaction {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  gymMemberId    String          @map("gym_member_id")
  expenseId      String?         @map("expense_id")
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("TRY")
  type           TransactionType
  paymentMethod  PaymentMethod?  @map("payment_method")
  reference      String?
  notes          String?
  createdById    String          @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  expense      Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, gymMemberId, createdAt])
  @@index([gymMemberId, type, createdAt])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// PaymentPlan — bir üyeye ait birden çok taksit (Expense) kaydını gruplar
// ---------------------------------------------------------------------------

model PaymentPlan {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  gymMemberId      String            @map("gym_member_id")
  description      String?
  installmentCount Int               @map("installment_count")
  status           PaymentPlanStatus @default(ACTIVE)
  createdById      String            @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PaymentPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@index([organizationId, gymMemberId, status])
  @@map("payment_plans")
}

// ---------------------------------------------------------------------------
// AuditLog — denetim izi
// ---------------------------------------------------------------------------

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  actorId        String?     @map("actor_id")
  action         AuditAction
  entityType     String?     @map("entity_type")
  entityId       String?     @map("entity_id")
  metadata       Json        @default("{}")
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// ApiToken — mobil / harici istemci Bearer erişimi (Faz 7)
// ---------------------------------------------------------------------------

model ApiToken {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  gymMemberId    String?          @map("gym_member_id")
  role           OrganizationRole?
  tokenHash      String           @unique @map("token_hash")
  scope          ApiTokenScope
  label          String?
  expiresAt      DateTime         @map("expires_at")
  revokedAt      DateTime?        @map("revoked_at")
  lastUsedAt     DateTime?        @map("last_used_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember?   @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([organizationId, scope])
  @@index([expiresAt])
  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// CheckIn — salon giriş kaydı (QR, RFID, turnike, manuel)
// ---------------------------------------------------------------------------

model CheckIn {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  subjectType    AccessSubjectType  @default(GYM_MEMBER) @map("subject_type")
  direction      AccessDirection    @default(ENTRY)
  gymMemberId    String?            @map("gym_member_id")
  staffUserId    String?            @map("staff_user_id")
  deviceId       String?            @map("device_id")
  clientEventId  String?            @map("client_event_id")
  method         CheckInMethod
  checkedInAt    DateTime           @default(now()) @map("checked_in_at")
  metadata       Json               @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember?   @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  staffUser    User?        @relation("StaffCheckIn", fields: [staffUserId], references: [id], onDelete: SetNull)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, checkedInAt])
  @@index([organizationId, direction, checkedInAt])
  @@index([gymMemberId, checkedInAt])
  @@index([staffUserId, checkedInAt])
  @@index([deviceId, checkedInAt])
  @@unique([deviceId, clientEventId])
  @@map("check_ins")
}

// ---------------------------------------------------------------------------
// SyncBatch — turnike offline kuyruk senkronizasyonu
// ---------------------------------------------------------------------------

model SyncBatch {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  deviceId       String          @map("device_id")
  eventCount     Int             @map("event_count")
  successCount   Int             @default(0) @map("success_count")
  failedCount    Int             @default(0) @map("failed_count")
  status         SyncBatchStatus @default(PENDING)
  result         Json            @default("[]")
  syncedAt       DateTime?       @map("synced_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([deviceId, createdAt])
  @@map("sync_batches")
}
