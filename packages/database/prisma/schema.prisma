// ---------------------------------------------------------------------------
// Aşağıdaki 6 enum + 9 model (bkz. TenantPaymentGateway/Product/MemberCard/
// Invoice/InvoiceItem/PaymentIntent/Notification/GymAccessLog/GymMemberActivity),
// başka bir oturumda doğrudan production'a `db push` ile eklenmiş, hiç commit
// edilmemiş bir tenant-seviyeli POS/fatura/ödeme-ağgeçidi çalışmasıydı (2026-07-19
// tarihli deploy sırasında keşfedildi). Uygulama kodu henüz bu modelleri
// kullanmıyor — yalnızca şema production'daki gerçek durumu yansıtsın ve
// gelecekteki migration'lar bu tabloları yanlışlıkla silmesin diye buraya
// eklendi. Gerçek kullanım (server actions/UI) ayrı bir görev.
// ---------------------------------------------------------------------------

enum GymAccessStatus {
  SUCCESS
  DENIED
}

enum GymMemberActivityType {
  CHECK_IN
  CHECK_OUT
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
  PARTIALLY_PAID
}

enum NotificationType {
  MESSAGE
  PROGRAM
  PAYMENT
  SYSTEM
}

enum PaymentIntentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProviderType {
  MANUAL
  STRIPE
  PAYPAL
  IYZICO
  PAYTR
  MOKA
  PARAM
}

// ---------------------------------------------------------------------------
// User — platform kullanıcıları (web panel girişi)
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String     @map("password_hash")
  name               String
  isSuperAdmin       Boolean    @default(false) @map("is_super_admin")
  isDemo             Boolean    @default(false) @map("is_demo")
  isPartner          Boolean    @default(false) @map("is_partner")
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  locale             String     @default("tr")
  avatarUrl          String?    @map("avatar_url")
  totpSecret         String?    @map("totp_secret")
  twoFactorEnabledAt DateTime?  @map("two_factor_enabled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  twoFactorBackupCodes    TwoFactorBackupCode[]
  staffInviteTokens       StaffInviteToken[]
  twoFactorRecoveryTokens TwoFactorRecoveryToken[]
  memberships             OrganizationMember[]
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  gymMemberProfile        GymMember?               @relation("GymMemberAccount")
  assignedAthletes        GymMember[]              @relation("GymMemberTrainer")
  trainingPrograms        TrainingProgram[]        @relation("TrainingProgramTrainer")
  sentMessages            DirectMessage[]          @relation("DirectMessageSender")
  receivedMessages        DirectMessage[]          @relation("DirectMessageReceiver")
  messageReports          MessageReport[]          @relation("MessageReportReporter")
  reviewedReports         MessageReport[]          @relation("MessageReportReviewer")
  apiTokens               ApiToken[]
  expensesCreated         Expense[]                @relation("ExpenseCreatedBy")
  transactionsCreated     Transaction[]            @relation("TransactionCreatedBy")
  paymentPlansCreated     PaymentPlan[]            @relation("PaymentPlanCreatedBy")
  staffCheckIns           CheckIn[]                @relation("StaffCheckIn")
  passwordResetTokens     PasswordResetToken[]
  partnerProfile          Partner?
  pushSubscriptions       PushSubscription[]
  trainerProfiles         TrainerProfile[]
  ptSessionsAsTrainer     PtSession[]              @relation("PtSessionTrainer")
  ptSessionsCreated       PtSession[]              @relation("PtSessionCreatedBy")
  hierarchyMemberships    HierarchyMember[]
  notifications           Notification[]

  @@index([status])
  @@index([isSuperAdmin])
  @@index([isPartner])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Partner — referans/temsilci hesabı. Kendi getirdiği (atanmış) organizasyonların
// üyelik süresi, özel indirimi ve ek kapasitesini sınırlı ve denetimli şekilde
// yönetebilir. Master Admin tarafından oluşturulur ve organizasyonlarla eşleştirilir.
// ---------------------------------------------------------------------------

model Partner {
  id             String  @id @default(cuid())
  userId         String  @unique @map("user_id")
  name           String
  code           String  @unique
  commissionRate Decimal @default(0) @map("commission_rate") @db.Decimal(5, 2)
  isActive       Boolean @default(true) @map("is_active")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations Organization[]

  @@index([isActive])
  @@map("partners")
}

// ---------------------------------------------------------------------------
// PushSubscription — tarayıcı Web Push aboneliği (VAPID). Kullanıcı bazlı, çoklu
// cihaz/tarayıcı desteklenir (aynı kullanıcı hem masaüstü hem telefon tarayıcısından
// abone olabilir).
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// TrainerProfile / PtSession — PT performans, komisyon ve prim yönetimi (Faz 21)
// ---------------------------------------------------------------------------

model TrainerProfile {
  id                 String            @id @default(cuid())
  organizationId     String            @map("organization_id")
  userId             String            @map("user_id")
  commissionModel    PtCommissionModel @default(FIXED_PER_SESSION) @map("commission_model")
  /**
   * FIXED_PER_SESSION için TRY tutar, PERCENTAGE_OF_REVENUE/TIERED için yüzde (0-100).
   */
  baseCommissionRate Decimal           @default(0) @map("base_commission_rate") @db.Decimal(7, 2)
  hourlyRate         Decimal?          @map("hourly_rate") @db.Decimal(10, 2)
  isActive           Boolean           @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, isActive])
  @@map("trainer_profiles")
}

model PtSession {
  id               String          @id @default(cuid())
  organizationId   String          @map("organization_id")
  trainerUserId    String          @map("trainer_user_id")
  gymMemberId      String          @map("gym_member_id")
  scheduledAt      DateTime        @map("scheduled_at")
  durationMinutes  Int             @default(60) @map("duration_minutes")
  status           PtSessionStatus @default(SCHEDULED)
  revenueAmount    Decimal?        @map("revenue_amount") @db.Decimal(10, 2)
  commissionAmount Decimal?        @map("commission_amount") @db.Decimal(10, 2)
  notes            String?
  completedAt      DateTime?       @map("completed_at")
  createdById      String          @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trainer      User         @relation("PtSessionTrainer", fields: [trainerUserId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PtSessionCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, trainerUserId, scheduledAt])
  @@index([organizationId, gymMemberId])
  @@index([organizationId, status])
  @@map("pt_sessions")
}

// ---------------------------------------------------------------------------
// HierarchyMember — kurumsal hiyerarşi (Faz 30). Bir kullanıcıya, bir organizasyon
// düğümünün (şirket/bölge) tüm alt ağacı üzerinde salt-okunur konsolide görünürlük
// verir. Mevcut OrganizationRole (OWNER/ADMIN/STAFF/TRAINER/VIEWER) yetki sistemine
// dokunmaz — tamamen ek ve ayrı bir katmandır; kullanıcı kendi şubesinde ayrıca bir
// OrganizationMember rolüne de sahip olabilir.
// ---------------------------------------------------------------------------

model HierarchyMember {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  userId         String        @map("user_id")
  role           HierarchyRole
  isActive       Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@map("hierarchy_members")
}

// ---------------------------------------------------------------------------
// PasswordResetToken — "şifremi unuttum" imzalı, süreli token (e-posta cloud.cicibyte.com üzerinden gider)
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// TwoFactorRecoveryToken — telefonunu ve yedek kodlarını kaybeden bir kullanıcı
// için e-posta ile 2FA sıfırlama linki (PasswordResetToken ile aynı desen).
// Bkz. roadmap.md Faz 36.3.
// ---------------------------------------------------------------------------

model TwoFactorRecoveryToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_recovery_tokens")
}

// ---------------------------------------------------------------------------
// TwoFactorBackupCode — 2FA kurtarma kodları (kullanıcı 2FA'yı etkinleştirdiğinde
// tek seferlik 10 adet kod üretilir, her biri bcrypt hash olarak saklanır).
// ---------------------------------------------------------------------------

model TwoFactorBackupCode {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

// ---------------------------------------------------------------------------
// StaffInviteToken — personel daveti: imzalı, süreli token ile personel kendi
// parolasını belirler (PasswordResetToken ile aynı desen).
// ---------------------------------------------------------------------------

model StaffInviteToken {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("staff_invite_tokens")
}

// ---------------------------------------------------------------------------
// PlatformPaymentSettings — SGMS'in kendi abonelik gelirini tahsil ettiği ödeme
// sağlayıcısı yapılandırması (tekil satır, Master Admin tarafından yönetilir).
// Tenant'ların kendi üyelerinden POS/cari tahsilatı bu modelden bağımsızdır.
// ---------------------------------------------------------------------------

model PlatformPaymentSettings {
  id            String         @id @default("singleton")
  activeGateway PaymentGateway @default(NONE) @map("active_gateway")

  iyzicoApiKey    String? @map("iyzico_api_key")
  iyzicoSecretKey String? @map("iyzico_secret_key")
  iyzicoBaseUrl   String  @default("https://sandbox-api.iyzipay.com") @map("iyzico_base_url")
  iyzicoSandbox   Boolean @default(true) @map("iyzico_sandbox")

  paytrMerchantId   String? @map("paytr_merchant_id")
  paytrMerchantKey  String? @map("paytr_merchant_key")
  paytrMerchantSalt String? @map("paytr_merchant_salt")
  paytrSandbox      Boolean @default(true) @map("paytr_sandbox")

  bankTransferEnabled Boolean @default(false) @map("bank_transfer_enabled")
  ibanHolderName      String? @map("iban_holder_name")
  ibanNumber          String? @map("iban_number")
  ibanBankName        String? @map("iban_bank_name")
  bankTransferNote    String? @map("bank_transfer_note") @db.Text

  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_payment_settings")
}

// ---------------------------------------------------------------------------
// GatewayCheckoutSession — iyzico/PayTR'a gönderilen sipariş kimliği (merchant_oid /
// conversationId) ↔ organizasyon/billingRequest eşlemesi. Webhook geldiğinde
// hangi organizasyonun aboneliğinin aktifleştirileceğini bulmak için kullanılır.
// ---------------------------------------------------------------------------

model GatewayCheckoutSession {
  id               String         @id
  organizationId   String         @map("organization_id")
  billingRequestId String         @map("billing_request_id")
  gateway          PaymentGateway
  status           String         @default("pending")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("gateway_checkout_sessions")
}

// ---------------------------------------------------------------------------
// Organization — spor salonu / tenant
// ---------------------------------------------------------------------------

model Organization {
  id       String             @id @default(cuid())
  name     String
  slug     String             @unique
  email    String?
  phone    String?
  address  String?
  city     String?
  country  String             @default("TR")
  timezone String             @default("Europe/Istanbul")
  status   OrganizationStatus @default(PENDING)
  settings Json               @default("{}")

  // Org düzeyinde merkezi platform kimliği (cloud.cicibyte.com — CiciByte Cloud tenant sync)
  installationId       String               @unique @map("installation_id")
  centralLicenseKey    String?              @unique @map("central_license_key")
  centralLicenseStatus CentralLicenseStatus @default(UNKNOWN) @map("central_license_status")
  centralLicenseType   String?              @map("central_license_type")
  licenseExpiresAt     DateTime?            @map("license_expires_at")
  trialStartedAt       DateTime?            @map("trial_started_at")
  lastLicenseCheckAt   DateTime?            @map("last_license_check_at")

  // Partner (temsilci) ataması — bu organizasyonu getiren temsilci, atandıysa
  // üyelik süresi / özel indirim / ek kapasite konularında sınırlı yönetim yetkisine sahiptir.
  partnerId String? @map("partner_id")

  // Plan'ın taban limitlerinin üzerine eklenen, organizasyona özel ek kapasite
  // (temsilci veya Master Admin tarafından tanımlanır — bkz. lib/tenant-access.ts).
  extraMemberCapacity Int @default(0) @map("extra_member_capacity")
  extraStaffCapacity  Int @default(0) @map("extra_staff_capacity")
  extraDeviceCapacity Int @default(0) @map("extra_device_capacity")

  // Kurumsal hiyerarşi (Faz 30) — bu şube/bölgenin bağlı olduğu üst düğüm (şirket/bölge).
  // Zincirleme ile keyfi derinlikte ağaç kurulabilir (Şirket → Bölge → Şube), ayrı bir
  // "tip" alanı gerektirmeden.
  parentOrganizationId String? @map("parent_organization_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner                 Partner?                 @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  parentOrganization      Organization?            @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations      Organization[]           @relation("OrganizationHierarchy")
  hierarchyMembers        HierarchyMember[]
  members                 OrganizationMember[]
  subscriptions           Subscription[]
  devices                 Device[]
  auditLogs               AuditLog[]
  gymMembershipPlans      GymMembershipPlan[]
  gymMembers              GymMember[]
  healthMeasurements      HealthMeasurement[]
  trainingPrograms        TrainingProgram[]
  exerciseSetLogs         ExerciseSetLog[]
  directMessages          DirectMessage[]
  messageReports          MessageReport[]
  apiTokens               ApiToken[]
  expenseCategories       ExpenseCategory[]
  expenses                Expense[]
  transactions            Transaction[]
  paymentPlans            PaymentPlan[]
  checkIns                CheckIn[]
  syncBatches             SyncBatch[]
  trainerProfiles         TrainerProfile[]
  ptSessions              PtSession[]
  proformaTokens          ProformaToken[]
  gatewayCheckoutSessions GatewayCheckoutSession[]
  tenantPaymentGateways   TenantPaymentGateway[]
  products                Product[]
  memberCards             MemberCard[]
  invoices                Invoice[]
  paymentIntents          PaymentIntent[]
  notifications           Notification[]
  gymAccessLogs           GymAccessLog[]
  gymMemberActivities     GymMemberActivity[]

  @@index([status])
  @@index([centralLicenseStatus])
  @@index([partnerId])
  @@index([parentOrganizationId])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// OrganizationMember — kullanıcı ↔ salon köprüsü
// ---------------------------------------------------------------------------

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(STAFF)
  isActive       Boolean          @default(true) @map("is_active")
  rfidTag        String?          @map("rfid_tag")
  invitedAt      DateTime?        @map("invited_at")
  joinedAt       DateTime?        @map("joined_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, rfidTag])
  @@index([userId, isActive])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Plan — SaaS paket tanımları (çoklu para birimi destekli)
// ---------------------------------------------------------------------------

model Plan {
  id          String  @id @default(cuid())
  code        String
  name        String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  priceMonthly Decimal @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal @default(0) @map("price_yearly") @db.Decimal(10, 2)
  currency     String  @default("TRY")

  maxMembers Int @default(100) @map("max_members")
  maxDevices Int @default(2) @map("max_devices")
  maxStaff   Int @default(5) @map("max_staff")

  features Json @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@unique([code, currency])
  @@index([isActive, sortOrder])
  @@index([currency])
  @@map("plans")
}

// ---------------------------------------------------------------------------
// Subscription — organizasyon ↔ plan ilişkisi
// ---------------------------------------------------------------------------

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(TRIALING)
  billingCycle   BillingCycle       @default(MONTHLY) @map("billing_cycle")

  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  canceledAt         DateTime? @map("canceled_at")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")

  // Atanmış temsilci tarafından tanımlanan, bu organizasyona özel indirim (bkz. Partner).
  partnerDiscountPercent Int?    @default(0) @map("partner_discount_percent")
  partnerDiscountNote    String? @map("partner_discount_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([planId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Device — turnike, kiosk (limitler yerel Plan tablosundan denetlenir)
// ---------------------------------------------------------------------------

model Device {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  type           DeviceType   @default(TURNSTILE)
  status         DeviceStatus @default(PENDING)

  hardwareId String  @map("hardware_id")
  apiKeyHash String? @unique @map("api_key_hash")
  location   String?
  metadata   Json    @default("{}")

  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkIns      CheckIn[]
  syncBatches   SyncBatch[]
  gymAccessLogs GymAccessLog[]

  @@unique([organizationId, hardwareId])
  @@index([organizationId, status])
  @@index([hardwareId])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// GymMembershipPlan — salonun müşterilerine sattığı yerel üyelik paketleri
// (SGMS SaaS Plan tablosundan bağımsız)
// ---------------------------------------------------------------------------

model GymMembershipPlan {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  description    String?
  durationDays   Int     @map("duration_days")
  price          Decimal @default(0) @db.Decimal(10, 2)
  currency       String  @default("TRY")
  isActive       Boolean @default(true) @map("is_active")
  sortOrder      Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMembers   GymMember[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
  @@map("gym_membership_plans")
}

// ---------------------------------------------------------------------------
// GymMember — salonun sporcu / üye kaydı (tenant müşterisi)
// ---------------------------------------------------------------------------

model GymMember {
  id                 String          @id @default(cuid())
  organizationId     String          @map("organization_id")
  planId             String?         @map("plan_id")
  userId             String?         @unique @map("user_id")
  trainerId          String?         @map("trainer_id")
  firstName          String          @map("first_name")
  lastName           String          @map("last_name")
  nationalId         String?         @map("national_id")
  isForeignMember    Boolean         @default(false) @map("is_foreign_member")
  nationality        String?
  passportNumber     String?         @map("passport_number")
  phone              String?
  email              String?
  birthDate          DateTime?       @map("birth_date") @db.Date
  gender             Gender          @default(UNSPECIFIED)
  status             GymMemberStatus @default(ACTIVE)
  membershipStartsAt DateTime?       @map("membership_starts_at")
  membershipEndsAt   DateTime?       @map("membership_ends_at")
  lastReminderSentAt DateTime?       @map("last_reminder_sent_at")
  notes              String?         @db.Text
  locale             String          @default("tr")
  avatarUrl          String?         @map("avatar_url")
  rfidTag            String?         @map("rfid_tag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                GymMembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  user                User?               @relation("GymMemberAccount", fields: [userId], references: [id], onDelete: SetNull)
  trainer             User?               @relation("GymMemberTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  healthMeasurements  HealthMeasurement[]
  trainingPrograms    TrainingProgram[]
  exerciseSetLogs     ExerciseSetLog[]
  apiTokens           ApiToken[]
  expenses            Expense[]
  transactions        Transaction[]
  paymentPlans        PaymentPlan[]
  checkIns            CheckIn[]
  ptSessions          PtSession[]
  memberCards         MemberCard[]
  invoices            Invoice[]
  paymentIntents      PaymentIntent[]
  gymAccessLogs       GymAccessLog[]
  gymMemberActivities GymMemberActivity[]

  @@unique([organizationId, nationalId])
  @@unique([organizationId, passportNumber])
  @@unique([organizationId, rfidTag])
  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, trainerId])
  @@index([trainerId])
  @@index([userId])
  @@index([phone])
  @@index([email])
  @@map("gym_members")
}

// ---------------------------------------------------------------------------
// HealthMeasurement — sağlık ve performans ölçümleri
// ---------------------------------------------------------------------------

model HealthMeasurement {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  gymMemberId       String   @map("gym_member_id")
  weight            Decimal? @db.Decimal(5, 2)
  bodyFatPercentage Decimal? @map("body_fat_percentage") @db.Decimal(5, 2)
  muscleMass        Decimal? @map("muscle_mass") @db.Decimal(5, 2)
  height            Decimal? @db.Decimal(5, 2)
  notes             String?  @db.Text
  measuredAt        DateTime @map("measured_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, gymMemberId, measuredAt])
  @@index([gymMemberId, measuredAt])
  @@map("health_measurements")
}

// ---------------------------------------------------------------------------
// TrainingProgram — antrenörün sporculara atadığı programlar
// ---------------------------------------------------------------------------

model TrainingProgram {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  gymMemberId    String      @map("gym_member_id")
  trainerId      String      @map("trainer_id")
  title          String
  type           ProgramType
  content        Json        @default("{}")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime?   @map("end_date") @db.Date
  isActive       Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember       GymMember        @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  trainer         User             @relation("TrainingProgramTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  exerciseSetLogs ExerciseSetLog[]

  @@index([organizationId, gymMemberId, isActive])
  @@index([organizationId, trainerId, isActive])
  @@index([gymMemberId, type, isActive])
  @@index([trainerId, startDate])
  @@map("training_programs")
}

// ---------------------------------------------------------------------------
// ExerciseSetLog — sporcunun kendi ilerleme takibi (PT içerik editörüne dokunmaz)
// ---------------------------------------------------------------------------

model ExerciseSetLog {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  trainingProgramId String   @map("training_program_id")
  gymMemberId       String   @map("gym_member_id")
  dayIndex          Int      @map("day_index")
  exerciseIndex     Int      @map("exercise_index")
  performedDate     DateTime @map("performed_date") @db.Date
  completedSets     Int      @default(0) @map("completed_sets")
  totalSets         Int      @map("total_sets")
  weightUsed        Decimal? @map("weight_used") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  gymMember       GymMember       @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@unique([trainingProgramId, gymMemberId, dayIndex, exerciseIndex, performedDate])
  @@index([organizationId, gymMemberId, performedDate])
  @@map("exercise_set_logs")
}

// ---------------------------------------------------------------------------
// DirectMessage — tenant içi mesajlaşma (PT ↔ sporcu ↔ yönetim)
// ---------------------------------------------------------------------------

model DirectMessage {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  senderId       String    @map("sender_id")
  receiverId     String    @map("receiver_id")
  content        String    @db.Text
  isRead         Boolean   @default(false) @map("is_read")
  deliveredAt    DateTime? @map("delivered_at")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       User            @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User            @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  reports      MessageReport[]

  @@index([organizationId, receiverId, isRead, createdAt])
  @@index([organizationId, senderId, createdAt])
  @@index([organizationId, senderId, receiverId, createdAt])
  @@map("direct_messages")
}

model MessageReport {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  messageId      String              @map("message_id")
  reporterId     String              @map("reporter_id")
  reason         String              @db.Text
  status         MessageReportStatus @default(OPEN)
  reviewedById   String?             @map("reviewed_by_id")
  reviewedAt     DateTime?           @map("reviewed_at")
  reviewNotes    String?             @map("review_notes") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter     User          @relation("MessageReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("MessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([messageId])
  @@map("message_reports")
}

// ---------------------------------------------------------------------------
// ExpenseCategory — org bazlı hızlı POS kalemleri (Su, protein vb.)
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  defaultAmount  Decimal? @map("default_amount") @db.Decimal(10, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
  @@map("expense_categories")
}

// ---------------------------------------------------------------------------
// Expense — üye cari borç kalemi
// ---------------------------------------------------------------------------

model Expense {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  gymMemberId    String        @map("gym_member_id")
  categoryId     String?       @map("category_id")
  paymentPlanId  String?       @map("payment_plan_id")
  amount         Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  currency       String        @default("TRY")
  description    String?
  status         ExpenseStatus @default(OPEN)
  dueDate        DateTime?     @map("due_date")
  createdById    String        @map("created_by_id")
  paidAt         DateTime?     @map("paid_at")
  voidedAt       DateTime?     @map("voided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember        @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentPlan  PaymentPlan?     @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([organizationId, gymMemberId, status, createdAt])
  @@index([gymMemberId, status])
  @@index([organizationId, status, dueDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Transaction — tahsilat / iade / düzeltme
// ---------------------------------------------------------------------------

model Transaction {
  id                   String          @id @default(cuid())
  organizationId       String          @map("organization_id")
  gymMemberId          String          @map("gym_member_id")
  expenseId            String?         @map("expense_id")
  invoiceId            String?         @map("invoice_id")
  gatewayId            String?         @map("gateway_id")
  gatewayTransactionId String?         @map("gateway_transaction_id")
  /// Kısmi/tam iade: bu kayıt hangi PAYMENT işleminin iadesi?
  refundOfTransactionId String?        @map("refund_of_transaction_id")
  amount               Decimal         @db.Decimal(10, 2)
  currency             String          @default("TRY")
  type                 TransactionType
  paymentMethod        PaymentMethod   @map("payment_method")
  reference            String?
  notes                String?
  createdById          String          @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember             @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  expense      Expense?              @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id])
  gateway      TenantPaymentGateway? @relation(fields: [gatewayId], references: [id])
  createdBy    User                  @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  refundOf     Transaction?          @relation("TransactionRefunds", fields: [refundOfTransactionId], references: [id], onDelete: SetNull)
  refunds      Transaction[]         @relation("TransactionRefunds")

  @@index([organizationId, gymMemberId, createdAt])
  @@index([gymMemberId, type, createdAt])
  @@index([invoiceId])
  @@index([gatewayId])
  @@index([refundOfTransactionId])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// ProformaToken — proforma fatura PDF'ine imzalı, süreli, kimliksiz erişim linki
// (salon sahibi platform girişi olmadan e-postadaki linkten indirebilir). Faturayı
// tetikleyen abonelik ödemesi (billingRequest) Organization.settings JSON'ında tutulur.
// ---------------------------------------------------------------------------

model ProformaToken {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  billingRequestId String    @map("billing_request_id")
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  /// pending | sent | failed — e-posta gönderim durumu (sessiz kayıp önleme)
  emailStatus      String    @default("pending") @map("email_status")
  emailSentAt      DateTime? @map("email_sent_at")
  lastEmailError   String?   @map("last_email_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([billingRequestId])
  @@index([emailStatus])
  @@index([expiresAt])
  @@map("proforma_tokens")
}

// ---------------------------------------------------------------------------
// PaymentPlan — bir üyeye ait birden çok taksit (Expense) kaydını gruplar
// ---------------------------------------------------------------------------

model PaymentPlan {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  gymMemberId      String            @map("gym_member_id")
  description      String?
  installmentCount Int               @map("installment_count")
  status           PaymentPlanStatus @default(ACTIVE)
  createdById      String            @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PaymentPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@index([organizationId, gymMemberId, status])
  @@map("payment_plans")
}

// ---------------------------------------------------------------------------
// AuditLog — denetim izi
// ---------------------------------------------------------------------------

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  actorId        String?     @map("actor_id")
  action         AuditAction
  entityType     String?     @map("entity_type")
  entityId       String?     @map("entity_id")
  metadata       Json        @default("{}")
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// HelpArticle — rol bazlı kullanım kılavuzu (Faz 33)
// ---------------------------------------------------------------------------

model HelpArticle {
  id                 String         @id @default(cuid())
  slug               String         @unique
  audiences          HelpAudience[]
  category           String
  sortOrder          Int            @default(0) @map("sort_order")
  isPublished        Boolean        @default(true) @map("is_published")
  relatedFeatureFlag String?        @map("related_feature_flag")
  isOnboardingGuide  Boolean        @default(false) @map("is_onboarding_guide")
  onboardingKey      String?        @map("onboarding_key")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  translations HelpArticleTranslation[]

  @@index([category, sortOrder])
  @@index([isOnboardingGuide])
  @@index([isPublished])
  @@map("help_articles")
}

model HelpArticleTranslation {
  id           String @id @default(cuid())
  articleId    String @map("article_id")
  locale       String
  title        String
  bodyMarkdown String @map("body_markdown") @db.Text

  article HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale])
  @@map("help_article_translations")
}

// ---------------------------------------------------------------------------
// ApiToken — mobil / harici istemci Bearer erişimi (Faz 7)
// ---------------------------------------------------------------------------

model ApiToken {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  organizationId String            @map("organization_id")
  gymMemberId    String?           @map("gym_member_id")
  role           OrganizationRole?
  tokenHash      String            @unique @map("token_hash")
  scope          ApiTokenScope
  label          String?
  expiresAt      DateTime          @map("expires_at")
  revokedAt      DateTime?         @map("revoked_at")
  lastUsedAt     DateTime?         @map("last_used_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember?   @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([organizationId, scope])
  @@index([expiresAt])
  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// CheckIn — salon giriş kaydı (QR, RFID, turnike, manuel)
// ---------------------------------------------------------------------------

model CheckIn {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  subjectType    AccessSubjectType @default(GYM_MEMBER) @map("subject_type")
  direction      AccessDirection   @default(ENTRY)
  gymMemberId    String?           @map("gym_member_id")
  staffUserId    String?           @map("staff_user_id")
  deviceId       String?           @map("device_id")
  clientEventId  String?           @map("client_event_id")
  method         CheckInMethod
  checkedInAt    DateTime          @default(now()) @map("checked_in_at")
  metadata       Json              @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember?   @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  staffUser    User?        @relation("StaffCheckIn", fields: [staffUserId], references: [id], onDelete: SetNull)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([deviceId, clientEventId])
  @@index([organizationId, checkedInAt])
  @@index([organizationId, direction, checkedInAt])
  @@index([gymMemberId, checkedInAt])
  @@index([staffUserId, checkedInAt])
  @@index([deviceId, checkedInAt])
  @@map("check_ins")
}

// ---------------------------------------------------------------------------
// SyncBatch — turnike offline kuyruk senkronizasyonu
// ---------------------------------------------------------------------------

model SyncBatch {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  deviceId       String          @map("device_id")
  eventCount     Int             @map("event_count")
  successCount   Int             @default(0) @map("success_count")
  failedCount    Int             @default(0) @map("failed_count")
  status         SyncBatchStatus @default(PENDING)
  result         Json            @default("[]")
  syncedAt       DateTime?       @map("synced_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([deviceId, createdAt])
  @@map("sync_batches")
}

// ---------------------------------------------------------------------------
// Tenant-seviyeli POS/fatura/ödeme-ağgeçidi modelleri — bkz. PaymentGateway
// enum'unun üzerindeki not. Uygulama kodu henüz bunları kullanmıyor.
// ---------------------------------------------------------------------------

model TenantPaymentGateway {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  provider       PaymentProviderType
  apiKey         String?             @map("api_key")
  secretKey      String?             @map("secret_key")
  merchantId     String?             @map("merchant_id")
  isActive       Boolean             @default(false) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([organizationId, provider])
  @@index([organizationId, isActive])
  @@map("tenant_payment_gateways")
}

model Product {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  price          Decimal @db.Decimal(10, 2)
  currency       String  @default("TRY")
  stock          Int?
  isActive       Boolean @default(true) @map("is_active")
  sortOrder      Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
  @@map("products")
}

model MemberCard {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  gymMemberId    String  @map("gym_member_id")
  cardAlias      String  @map("card_alias")
  paymentToken   String  @map("payment_token")
  brand          String?
  lastFour       String? @map("last_four")
  expiryMonth    Int?    @map("expiry_month")
  expiryYear     Int?    @map("expiry_year")
  isDefault      Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, gymMemberId])
  @@index([gymMemberId, isDefault])
  @@map("member_cards")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  gymMemberId    String        @map("gym_member_id")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency       String        @default("TRY")
  status         InvoiceStatus @default(UNPAID)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember      GymMember       @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]
  paymentIntents PaymentIntent[]
  transactions   Transaction[]

  @@index([organizationId, gymMemberId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([gymMemberId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String   @map("invoice_id")
  productId String?  @map("product_id")
  name      String
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model PaymentIntent {
  id              String              @id @default(cuid())
  organizationId  String              @map("organization_id")
  gymMemberId     String              @map("gym_member_id")
  invoiceId       String?             @map("invoice_id")
  requestedAmount Decimal             @map("requested_amount") @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentIntentStatus @default(PENDING)
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, gymMemberId, status])
  @@index([organizationId, status, createdAt])
  @@index([gymMemberId, createdAt])
  @@map("payment_intents")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String?          @map("organization_id")
  userId         String           @map("user_id")
  type           NotificationType
  title          String
  body           String
  actionUrl      String?          @map("action_url")
  isRead         Boolean          @default(false) @map("is_read")
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model GymAccessLog {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  gymMemberId    String?         @map("gym_member_id")
  deviceId       String?         @map("device_id")
  terminalId     String          @map("terminal_id")
  accessTime     DateTime        @map("access_time")
  status         GymAccessStatus
  reason         String?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember?   @relation(fields: [gymMemberId], references: [id])
  device       Device?      @relation(fields: [deviceId], references: [id])

  @@index([organizationId, accessTime])
  @@index([gymMemberId, accessTime])
  @@index([deviceId, accessTime])
  @@index([terminalId, accessTime])
  @@map("gym_access_logs")
}

model GymMemberActivity {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  gymMemberId    String                @map("gym_member_id")
  type           GymMemberActivityType @default(CHECK_IN)
  activityAt     DateTime              @map("activity_at")
  source         String                @default("qr")
  terminalId     String?               @map("terminal_id")
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gymMember    GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId, activityAt])
  @@index([gymMemberId, type, activityAt])
  @@index([organizationId, gymMemberId, activityAt])
  @@map("gym_member_activities")
}
