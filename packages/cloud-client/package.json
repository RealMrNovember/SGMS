{
  "name": "@sgms/cloud-client",
  "version": "0.1.0",
  "private": true,
  "description": "CiciByte Cloud (cloud.cicibyte.com) platform client — tenant sync, licensing & offline-token API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
